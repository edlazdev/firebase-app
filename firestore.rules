rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anything not matched below is denied by default.
    match /urls/{id} {
      // Owner can read and modify their own URL documents.
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.user;
      // Any signed-in user can create, but only as themselves.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user;
    }
  }
}